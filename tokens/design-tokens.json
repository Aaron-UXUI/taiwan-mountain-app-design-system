  "typography": {
    "_comment": "size/lineHeight in px. letterSpacing is Figma 的 Spacing 欄位，單位 em（2% = 0.02）；只有非 0 的層級會輸出 CSS 變數。weight/family are keys into fontWeight/typeface above. swiftRelativeTo is the built-in Font.TextStyle each size scales relative to via @ScaledMetric on the SwiftUI side — see swiftui/README.md.",
    "headline1": {
      "size": 40, "lineHeight": 56, "letterSpacing": 0.02, "weight": "regular", "family": "pingfang-tc",
      "cssSizeVar": "--type-scale-headline-1", "cssLineHeightVar": "--line-height-h1",
      "cssLetterSpacingVar": "--letter-spacing-h1",
      "swiftName": "headline1", "swiftRelativeTo": "largeTitle",
      "note": "Figma Style Guide 本身標記 Regular/2% letter-spacing，跟 H2–H4（皆 Semibold/0%）不一致，疑似文件錯誤，忠實保留而非逕自修正"
    },
    "headline2": { "size": 24, "lineHeight": 36, "weight": "semibold", "family": "pingfang-tc", "cssSizeVar": "--type-scale-headline-2", "cssLineHeightVar": "--line-height-h2", "swiftName": "headline2", "swiftRelativeTo": "title" },
    "headline3": { "size": 20, "lineHeight": 30, "weight": "semibold", "family": "pingfang-tc", "cssSizeVar": "--type-scale-headline-3", "cssLineHeightVar": "--line-height-h3", "swiftName": "headline3", "swiftRelativeTo": "title2" },
    "headline4": { "size": 16, "lineHeight": 24, "weight": "semibold", "family": "pingfang-tc", "cssSizeVar": "--type-scale-headline-4", "cssLineHeightVar": "--line-height-h4", "swiftName": "headline4", "swiftRelativeTo": "headline" },
    "bodyL": { "size": 16, "lineHeight": 24, "weight": "regular", "family": "pingfang-tc", "cssSizeVar": "--type-scale-body-l", "cssLineHeightVar": "--line-height-body-l", "swiftName": "bodyL", "swiftRelativeTo": "body" },
    "bodyM": { "size": 14, "lineHeight": 18, "weight": "regular", "family": "pingfang-tc", "cssSizeVar": "--type-scale-body-m", "cssLineHeightVar": "--line-height-body-m", "swiftName": "bodyM", "swiftRelativeTo": "subheadline" },
    "bodyS": { "size": 12, "lineHeight": 16, "weight": "regular", "family": "pingfang-tc", "cssSizeVar": "--type-scale-body-s", "cssLineHeightVar": "--line-height-body-s", "swiftName": "bodyS", "swiftRelativeTo": "footnote" },
