  "elevation": {
    "_comment": "css is the literal box-shadow shorthand (may reference color tokens via var()). swiftLayers mirrors the same layers for SwiftUI — colorRef keys into the swiftColorRefs lookup in tokens/build-tokens.mjs, and `blur` is Figma 的 drop-shadow radius，也就是 CSS 的 blur-radius，兩者同一個數字。CSS blur-radius 定義為 2σ，而 SwiftUI .shadow(radius:) 收的是 σ，所以產生 Swift 時一律除以 2；不要在這份 JSON 裡先換算，這裡只放 Figma 的原始值。",
    "level1": {
      "css": "0 1px 2px 0 var(--color-gray-100)",
      "swiftName": "level1",
      "swiftLayers": [{ "colorRef": "gray100", "blur": 2, "x": 0, "y": 1 }]
    },
    "level2": {
      "css": "0 1px 4px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.08)",
      "swiftName": "level2",
      "swiftLayers": [
        { "colorRef": "black8", "blur": 4, "x": 0, "y": 1 },
        { "colorRef": "black8", "blur": 8, "x": 0, "y": 2 }
      ]
    },
    "level3": {
      "css": "0 2px 1px rgba(0, 0, 0, 0.12), 0 2px 12px rgba(0, 0, 0, 0.12)",
      "swiftName": "level3",
      "swiftLayers": [
        { "colorRef": "black12", "blur": 1, "x": 0, "y": 2 },
        { "colorRef": "black12", "blur": 12, "x": 0, "y": 2 }
      ]
    },
    "level4": {
      "css": "0 6px 20px rgba(0, 0, 0, 0.12)",
      "swiftName": "level4",
      "swiftLayers": [{ "colorRef": "black12", "blur": 20, "x": 0, "y": 6 }]
    },
    "level5": {
      "css": "0 8px 32px rgba(0, 0, 0, 0.16), 0 2px 4px rgba(0, 0, 0, 0.12)",
      "swiftName": "level5",
      "swiftLayers": [
        { "colorRef": "black16", "blur": 32, "x": 0, "y": 8 },
        { "colorRef": "black12", "blur": 4, "x": 0, "y": 2 }
      ]
    }
  },
